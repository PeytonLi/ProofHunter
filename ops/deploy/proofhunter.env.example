PROOFHUNTER_PROFILE=offline
UV_OFFLINE=1
PROOFHUNTER_DB_PATH=/var/lib/proofhunter/runs.sqlite3
PROOFHUNTER_BIND_HOST=127.0.0.1
PROOFHUNTER_BIND_PORT=8000
PROOFHUNTER_API_BASE=http://127.0.0.1:8000
PROOFHUNTER_ENABLE_LIVE_RUNNER=false
PROOFHUNTER_ENABLE_GITHUB_WEBHOOK=false
PROOFHUNTER_ENABLE_GITHUB_CHECKS=false
# Supply distinct local test-only transport tokens separately for offline serve.
# No live credentials belong in this template.
