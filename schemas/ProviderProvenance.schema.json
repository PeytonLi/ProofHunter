{
  "$defs": {
    "ProviderMode": {
      "enum": [
        "live",
        "stub",
        "fallback",
        "policy",
        "offline_fixture",
        "disabled",
        "not_called"
      ],
      "title": "ProviderMode",
      "type": "string"
    },
    "ProviderName": {
      "enum": [
        "github",
        "meta",
        "snap",
        "runner"
      ],
      "title": "ProviderName",
      "type": "string"
    },
    "ReasonCode": {
      "description": "Machine reason codes for errors, stop reasons and verdict reasons.",
      "enum": [
        "invalid_pr_url",
        "repo_not_enrolled",
        "fork_unsupported",
        "revision_unavailable",
        "oracle_unavailable",
        "isolation_unverified",
        "provider_unavailable",
        "budget_exhausted",
        "nondeterministic",
        "coverage_insufficient",
        "stale_event",
        "conflicting_idempotency_key",
        "internal_error",
        "confirmed_evidence",
        "coverage_complete",
        "inputs_exhausted",
        "deadline_exceeded",
        "trust_failure",
        "preexisting_mismatch_changed",
        "unsupported_contract",
        "source_invalid",
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "receipt_pending",
        "replay_unavailable",
        "rate_limited",
        "payload_too_large",
        "invalid_signature",
        "feature_disabled",
        "provider_timeout",
        "provider_refused",
        "provider_invalid_response",
        "receipt_tampered",
        "lease_lost"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Sanitized metadata for one provider interaction (no bodies, no credentials).",
  "properties": {
    "attempts": {
      "maximum": 3,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "latency_ms": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latency Ms"
    },
    "mode": {
      "$ref": "#/$defs/ProviderMode"
    },
    "model_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Id"
    },
    "provider": {
      "$ref": "#/$defs/ProviderName"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Id"
    }
  },
  "required": [
    "provider",
    "mode",
    "model_id",
    "request_id",
    "latency_ms",
    "attempts",
    "reason_code"
  ],
  "title": "ProviderProvenance",
  "type": "object"
}
