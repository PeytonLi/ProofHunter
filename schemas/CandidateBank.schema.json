{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "coverage_tags": {
          "items": {
            "$ref": "#/$defs/CoverageTag"
          },
          "maxItems": 8,
          "title": "Coverage Tags",
          "type": "array"
        },
        "discount_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Discount Percent",
          "type": "integer"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "is_anchor": {
          "title": "Is Anchor",
          "type": "boolean"
        },
        "prices_cents": {
          "items": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Prices Cents",
          "type": "array"
        },
        "strategy": {
          "$ref": "#/$defs/Strategy"
        }
      },
      "required": [
        "prices_cents",
        "discount_percent",
        "input_sha256",
        "strategy",
        "is_anchor",
        "coverage_tags",
        "generator_version"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CoverageTag": {
      "enum": [
        "empty",
        "singleton",
        "multi_item",
        "zero_discount",
        "full_discount",
        "half_cent",
        "max_items",
        "max_price"
      ],
      "title": "CoverageTag",
      "type": "string"
    },
    "Strategy": {
      "enum": [
        "boundary",
        "constraint",
        "seeded_fuzz"
      ],
      "title": "Strategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bank_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bank Sha256",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 64,
      "title": "Candidates",
      "type": "array"
    },
    "generator_version": {
      "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
      "title": "Generator Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    }
  },
  "required": [
    "generator_version",
    "seed",
    "candidates",
    "bank_sha256"
  ],
  "title": "CandidateBank",
  "type": "object"
}
