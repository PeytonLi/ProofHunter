      "type": "string"
    },
    "base_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Source Sha256",
      "type": "string"
    },
    "command": {
      "maxLength": 256,
      "title": "Command",
      "type": "string"
    },
