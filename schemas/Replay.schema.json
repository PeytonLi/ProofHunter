    "input_sha256",
    "base_sha",
    "head_sha",
    "base_source_sha256",
    "head_source_sha256",
    "harness_version",
    "harness_sha256",
    "contract_id",
    "contract_sha256",
    "oracle_version",
    "snapshot_id",
    "image_digest",
