{
  "$defs": {
    "AttemptStatus": {
      "enum": [
        "reserved",
        "running",
        "completed",
        "ambiguous",
        "cancelled"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Limits plus consumed counts, deadline, wall clock and cost (or unknown).",
      "properties": {
        "cost": {
          "$ref": "#/$defs/CostRecord"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/BudgetLimits"
        },
        "used": {
          "$ref": "#/$defs/BudgetUsage"
        },
        "wall_clock_ms": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wall Clock Ms"
        }
      },
      "required": [
        "limits",
        "used",
        "deadline_at",
        "wall_clock_ms",
        "cost"
      ],
      "title": "Budget",
      "type": "object"
    },
    "BudgetLimits": {
      "additionalProperties": false,
      "description": "Per-run limits (PRD section 2 defaults); enforced before spending.",
      "properties": {
        "deadline_seconds": {
          "default": 180,
          "maximum": 180,
          "minimum": 1,
          "title": "Deadline Seconds",
          "type": "integer"
        },
        "invocation_timeout_seconds": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Invocation Timeout Seconds",
          "type": "integer"
        },
        "max_candidates": {
          "default": 64,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_confirmations": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Confirmations",
          "type": "integer"
        },
        "max_context_bytes": {
          "default": 32768,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Context Bytes",
          "type": "integer"
        },
        "max_hypotheses": {
          "default": 8,
          "maximum": 8,
          "minimum": 2,
          "title": "Max Hypotheses",
          "type": "integer"
        },
        "max_meta_requests": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Meta Requests",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 16384,
          "maximum": 16384,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_pairs": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Pairs",
          "type": "integer"
        },
        "max_sandbox_invocations": {
          "default": 15,
          "maximum": 15,
          "minimum": 1,
          "title": "Max Sandbox Invocations",
          "type": "integer"
        },
        "max_snap_requests": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Snap Requests",
          "type": "integer"
        }
      },
      "title": "BudgetLimits",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "candidates_generated": {
          "maximum": 64,
          "minimum": 0,
          "title": "Candidates Generated",
          "type": "integer"
        },
        "confirmations": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confirmations",
          "type": "integer"
        },
        "meta_requests": {
          "maximum": 2,
          "minimum": 0,
          "title": "Meta Requests",
          "type": "integer"
        },
        "pairs": {
          "maximum": 6,
          "minimum": 0,
          "title": "Pairs",
          "type": "integer"
        },
        "sandbox_invocations": {
          "maximum": 15,
          "minimum": 0,
          "title": "Sandbox Invocations",
          "type": "integer"
        },
        "snap_requests": {
          "maximum": 3,
          "minimum": 0,
          "title": "Snap Requests",
          "type": "integer"
        }
      },
      "required": [
        "pairs",
        "confirmations",
        "sandbox_invocations",
        "meta_requests",
        "snap_requests",
        "candidates_generated"
      ],
      "title": "BudgetUsage",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "coverage_tags": {
          "items": {
            "$ref": "#/$defs/CoverageTag"
          },
          "maxItems": 8,
          "title": "Coverage Tags",
          "type": "array"
        },
        "discount_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Discount Percent",
          "type": "integer"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "is_anchor": {
          "title": "Is Anchor",
          "type": "boolean"
        },
        "prices_cents": {
          "items": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Prices Cents",
          "type": "array"
        },
        "strategy": {
          "$ref": "#/$defs/Strategy"
        }
      },
      "required": [
        "prices_cents",
        "discount_percent",
        "input_sha256",
        "strategy",
        "is_anchor",
        "coverage_tags",
        "generator_version"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateInput": {
      "additionalProperties": false,
      "description": "Legal input of ``checkout-rounding@1``.",
      "properties": {
        "discount_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Discount Percent",
          "type": "integer"
        },
        "prices_cents": {
          "items": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Prices Cents",
          "type": "array"
        }
      },
      "required": [
        "prices_cents",
        "discount_percent"
      ],
      "title": "CandidateInput",
      "type": "object"
    },
    "ConfirmationStatus": {
      "enum": [
        "not_attempted",
        "reproduced",
        "disagreed",
        "unusable"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "CostRecord": {
      "additionalProperties": false,
      "properties": {
        "amount_usd_micros": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount Usd Micros"
        },
        "status": {
          "$ref": "#/$defs/CostStatus"
        }
      },
      "required": [
        "status",
        "amount_usd_micros"
      ],
      "title": "CostRecord",
      "type": "object"
    },
    "CostStatus": {
      "enum": [
        "measured",
        "unknown"
      ],
      "title": "CostStatus",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "coverage_guard_used": {
          "title": "Coverage Guard Used",
          "type": "boolean"
        },
        "distinct_usable_pairs": {
          "maximum": 15,
          "minimum": 0,
          "title": "Distinct Usable Pairs",
          "type": "integer"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/CoverageTag"
          },
          "maxItems": 8,
          "title": "Missing",
          "type": "array"
        },
        "observed": {
          "items": {
            "$ref": "#/$defs/CoverageTag"
          },
          "maxItems": 8,
          "title": "Observed",
          "type": "array"
        },
        "required": {
          "items": {
            "$ref": "#/$defs/CoverageTag"
          },
          "maxItems": 8,
          "title": "Required",
          "type": "array"
        }
      },
      "required": [
        "required",
        "observed",
        "missing",
        "distinct_usable_pairs",
        "coverage_guard_used"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CoverageTag": {
      "enum": [
        "empty",
        "singleton",
        "multi_item",
        "zero_discount",
        "full_discount",
        "half_cent",
        "max_items",
        "max_price"
      ],
      "title": "CoverageTag",
      "type": "string"
    },
    "EvidenceKind": {
      "description": "Classification of one probe pair relative to the T1 oracle.\n\n* ``match``: base = expected and head = expected (usable, Y=match).\n* ``head_mismatch``: base = expected, head != expected (usable, Y=mismatch).\n* ``shared_mismatch``: base = head != expected (pre-existing defect, no update).\n* ``base_mismatch``: base != expected and head != base (no update).\n* ``excluded``: unusable pair (see ``ExclusionReason``), no update.",
      "enum": [
        "match",
        "head_mismatch",
        "shared_mismatch",
        "base_mismatch",
        "excluded"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "ExclusionReason": {
      "enum": [
        "base_mismatch",
        "timeout",
        "nonzero_exit",
        "invalid_output",
        "denied",
        "infra_error",
        "trust_failure",
        "duplicate",
        "oracle_unavailable",
        "budget_exhausted"
      ],
      "title": "ExclusionReason",
      "type": "string"
    },
    "ExecutionMode": {
      "enum": [
        "live",
        "offline_fixture"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "HypothesisId": {
      "description": "Canonical hypothesis IDs, assigned only by the local app.",
      "enum": [
        "H0",
        "per_item_rounding",
        "half_even_rounding",
        "other"
      ],
      "title": "HypothesisId",
      "type": "string"
    },
    "HypothesisSource": {
      "enum": [
        "meta",
        "builtin",
        "mandatory"
      ],
      "title": "HypothesisSource",
      "type": "string"
    },
    "HypothesisSummary": {
      "additionalProperties": false,
      "description": "Receipt record of retained hypotheses and the persisted initial prior.",
      "properties": {
        "initial_prior": {
          "additionalProperties": {
            "ge": 0.0,
            "le": 1.0,
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/HypothesisId"
          },
          "title": "Initial Prior",
          "type": "object"
        },
        "plan_source": {
          "$ref": "#/$defs/PlanSource"
        },
        "prior_policy": {
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Prior Policy",
          "type": "string"
        },
        "rejected_proposals": {
          "maximum": 6,
          "minimum": 0,
          "title": "Rejected Proposals",
          "type": "integer"
        },
        "retained": {
          "items": {
            "$ref": "#/$defs/RetainedHypothesis"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Retained",
          "type": "array"
        }
      },
      "required": [
        "plan_source",
        "prior_policy",
        "retained",
        "initial_prior",
        "rejected_proposals"
      ],
      "title": "HypothesisSummary",
      "type": "object"
    },
    "ObservationOutcome": {
      "enum": [
        "ok",
        "timeout",
        "nonzero",
        "invalid",
        "denied",
        "infra_error"
      ],
      "title": "ObservationOutcome",
      "type": "string"
    },
    "OracleResult": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "checkout-rounding@1",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "expected_cents": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Cents"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "oracle_version": {
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Oracle Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OracleStatus"
        },
        "trust_tier": {
          "$ref": "#/$defs/TrustTier"
        }
      },
      "required": [
        "contract_id",
        "contract_sha256",
        "oracle_version",
        "input_sha256",
        "trust_tier",
        "expected_cents",
        "status"
      ],
      "title": "OracleResult",
      "type": "object"
    },
    "OracleStatus": {
      "enum": [
        "ok",
        "unavailable",
        "invalid"
      ],
      "title": "OracleStatus",
      "type": "string"
    },
    "PlanConstraints": {
      "additionalProperties": false,
      "properties": {
        "discount_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discount Percent"
        },
        "max_items": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Items"
        },
        "min_items": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Items"
        },
        "require_fractional_cent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Require Fractional Cent"
        }
      },
      "required": [
        "min_items",
        "max_items",
        "discount_percent",
        "require_fractional_cent"
      ],
      "title": "PlanConstraints",
      "type": "object"
    },
    "PlanSource": {
      "enum": [
        "meta",
        "builtin_fallback",
        "builtin_restored",
        "offline_fixture"
      ],
      "title": "PlanSource",
      "type": "string"
    },
    "PolicyVersions": {
      "additionalProperties": false,
      "properties": {
        "canonical_serializer": {
          "default": "ph-canonical-json-v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Canonical Serializer",
          "type": "string"
        },
        "generator_version": {
          "default": "candidate-generator-v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Generator Version",
          "type": "string"
        },
        "harness_version": {
          "default": "proofhunter-harness@1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Harness Version",
          "type": "string"
        },
        "likelihood_policy": {
          "default": "rounding-likelihood-v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Likelihood Policy",
          "type": "string"
        },
        "oracle_version": {
          "default": "checkout-rounding-oracle@1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Oracle Version",
          "type": "string"
        },
        "prior_policy": {
          "default": "v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Prior Policy",
          "type": "string"
        },
        "route_fallback_policy": {
          "default": "route-fallback-v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Route Fallback Policy",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_policy": {
          "default": "eig-select-v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Selection Policy",
          "type": "string"
        },
        "verdict_policy": {
          "default": "verdict-rules-v1",
          "pattern": "^[A-Za-z0-9._@:+-]{1,64}$",
          "title": "Verdict Policy",
          "type": "string"
        }
      },
      "title": "PolicyVersions",
      "type": "object"
    },
    "ProviderMode": {
      "enum": [
        "live",
        "stub",
        "fallback",
        "policy",
        "offline_fixture",
        "disabled",
        "not_called"
      ],
      "title": "ProviderMode",
      "type": "string"
    },
    "ProviderName": {
      "enum": [
        "github",
        "meta",
        "snap",
        "runner"
      ],
      "title": "ProviderName",
      "type": "string"
    },
    "ProviderUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "maximum": 15,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "fallbacks": {
          "maximum": 15,
          "minimum": 0,
          "title": "Fallbacks",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/ProviderMode"
        },
        "model_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Id"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "model_id",
        "calls",
        "fallbacks",
        "reason_code"
      ],
      "title": "ProviderUsage",
      "type": "object"
    },
    "PublicObservation": {
      "additionalProperties": false,
      "description": "``SandboxObservation`` without operator identifiers (no ``sandbox_id``).",
      "properties": {
        "attempt_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "duration_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "harness_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Harness Sha256",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ObservationOutcome"
        },
        "runner_mode": {
          "$ref": "#/$defs/RunnerMode"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stderr_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stderr Sha256"
        },
        "stdout_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stdout Sha256"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "attempt_id",
        "side",
        "commit_sha",
        "source_sha256",
        "input_sha256",
        "runner_mode",
        "snapshot_id",
        "image_digest",
        "harness_sha256",
        "started_at",
        "duration_ms",
        "outcome",
        "value",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "truncated"
      ],
      "title": "PublicObservation",
      "type": "object"
    },
    "PublicProbeRecord": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/PublicObservation"
        },
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "candidate_pool_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Pool Sha256",
          "type": "string"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmation_status": {
          "$ref": "#/$defs/ConfirmationStatus"
        },
        "eig_bits": {
          "ge": 0.0,
          "le": 3.0,
          "title": "Eig Bits",
          "type": "number"
        },
        "evidence_kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "exclusion_reason": {
          "anyOf": [
            {
