{
  "$defs": {
    "HypothesisMode": {
      "description": "Failure modes a provider may propose (H0 is always implicit).",
      "enum": [
        "per_item_rounding",
        "half_even_rounding",
        "other"
      ],
      "title": "HypothesisMode",
      "type": "string"
    },
    "HypothesisProposal": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "$ref": "#/$defs/PlanConstraints"
        },
        "mode": {
          "$ref": "#/$defs/HypothesisMode"
        },
        "rationale": {
          "maxLength": 300,
          "title": "Rationale",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 4,
          "title": "Source Refs",
          "type": "array"
        },
        "suggested_strategy": {
          "$ref": "#/$defs/Strategy"
        }
      },
      "required": [
        "mode",
        "rationale",
        "source_refs",
        "suggested_strategy",
        "constraints"
      ],
      "title": "HypothesisProposal",
      "type": "object"
    },
    "PlanConstraints": {
      "additionalProperties": false,
      "properties": {
        "discount_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discount Percent"
        },
        "max_items": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Items"
        },
        "min_items": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Items"
        },
        "require_fractional_cent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Require Fractional Cent"
        }
      },
      "required": [
        "min_items",
        "max_items",
        "discount_percent",
        "require_fractional_cent"
      ],
      "title": "PlanConstraints",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "maxLength": 200,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]{1,200}$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Strategy": {
      "enum": [
        "boundary",
        "constraint",
        "seeded_fuzz"
      ],
      "title": "Strategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Exact provider-facing JSON (Meta structured output). No IDs, no provenance.",
  "properties": {
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/HypothesisProposal"
      },
      "maxItems": 6,
      "title": "Hypotheses",
      "type": "array"
    }
  },
  "required": [
    "hypotheses"
  ],
  "title": "HypothesisPlanPayload",
  "type": "object"
}
