{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "retryable"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Machine reason codes for errors, stop reasons and verdict reasons.",
      "enum": [
        "invalid_pr_url",
        "repo_not_enrolled",
        "fork_unsupported",
        "revision_unavailable",
        "oracle_unavailable",
        "isolation_unverified",
        "provider_unavailable",
        "budget_exhausted",
        "nondeterministic",
        "coverage_insufficient",
        "stale_event",
        "conflicting_idempotency_key",
        "internal_error",
        "confirmed_evidence",
        "coverage_complete",
        "inputs_exhausted",
        "deadline_exceeded",
        "trust_failure",
        "preexisting_mismatch_changed",
        "unsupported_contract",
        "source_invalid",
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "receipt_pending",
        "replay_unavailable",
        "rate_limited",
        "payload_too_large",
        "invalid_signature",
        "feature_disabled",
        "provider_timeout",
        "provider_refused",
        "provider_invalid_response",
        "receipt_tampered",
        "lease_lost"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
