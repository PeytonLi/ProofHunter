{
  "$defs": {
    "AttemptStatus": {
      "enum": [
        "reserved",
        "running",
        "completed",
        "ambiguous",
        "cancelled"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "ObservationOutcome": {
      "enum": [
        "ok",
        "timeout",
        "nonzero",
        "invalid",
        "denied",
        "infra_error"
      ],
      "title": "ObservationOutcome",
      "type": "string"
    },
    "ReasonCode": {
      "description": "Machine reason codes for errors, stop reasons and verdict reasons.",
      "enum": [
        "invalid_pr_url",
        "repo_not_enrolled",
        "fork_unsupported",
        "revision_unavailable",
        "oracle_unavailable",
        "isolation_unverified",
        "provider_unavailable",
        "budget_exhausted",
        "nondeterministic",
        "coverage_insufficient",
        "stale_event",
        "conflicting_idempotency_key",
        "internal_error",
        "confirmed_evidence",
        "coverage_complete",
        "inputs_exhausted",
        "deadline_exceeded",
        "trust_failure",
        "preexisting_mismatch_changed",
        "unsupported_contract",
        "source_invalid",
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "receipt_pending",
        "replay_unavailable",
        "rate_limited",
        "payload_too_large",
        "invalid_signature",
        "feature_disabled",
        "provider_timeout",
        "provider_refused",
        "provider_invalid_response",
        "receipt_tampered",
        "lease_lost"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RunnerMode": {
      "enum": [
        "daytona",
        "offline_fixture"
      ],
      "title": "RunnerMode",
      "type": "string"
    },
    "SandboxObservation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "duration_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "harness_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Harness Sha256",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ObservationOutcome"
        },
        "runner_mode": {
          "$ref": "#/$defs/RunnerMode"
        },
        "sandbox_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sandbox Id"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9._:@/+=-]{1,128}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stderr_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stderr Sha256"
        },
        "stdout_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stdout Sha256"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "attempt_id",
        "side",
        "commit_sha",
        "source_sha256",
        "input_sha256",
        "runner_mode",
        "snapshot_id",
        "image_digest",
        "harness_sha256",
        "sandbox_id",
        "started_at",
        "duration_ms",
        "outcome",
        "value",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "truncated"
      ],
      "title": "SandboxObservation",
      "type": "object"
    },
    "Side": {
      "enum": [
        "base",
        "head",
        "confirm"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Append-only raw attempt (distinct from logical observation keys).",
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "charged": {
      "title": "Charged",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "lease_epoch": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Lease Epoch",
      "type": "integer"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SandboxObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "probe_no": {
      "anyOf": [
        {
          "maximum": 15,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Probe No"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/Side"
    },
    "status": {
      "$ref": "#/$defs/AttemptStatus"
    }
  },
  "required": [
    "run_id",
    "attempt_id",
    "side",
    "input_sha256",
    "probe_no",
    "status",
    "charged",
    "lease_epoch",
    "created_at",
    "observation",
    "reason_code"
  ],
  "title": "AttemptRecord",
  "type": "object"
}
