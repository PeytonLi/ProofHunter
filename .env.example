# ProofHunter configuration. Copy to .env for local use; never commit real values.
# Defaults are offline. In the offline profile provider credentials are never read
# and every PROOFHUNTER_ENABLE_* live flag must stay false.

# --- Control API and worker
PROOFHUNTER_PROFILE=offline
PROOFHUNTER_DB_PATH=.proofhunter/proofhunter.sqlite3
PROOFHUNTER_ENROLLMENTS=config/enrollments.example.json
PROOFHUNTER_API_BASE=http://127.0.0.1:8000
PROOFHUNTER_BIND_HOST=127.0.0.1
PROOFHUNTER_BIND_PORT=8000
PROOFHUNTER_ACCEPTED_RUNS_PER_HOUR=6
PROOFHUNTER_ENABLE_INTAKE=true
# Service bearer token (API + ACP client) and separate operator token (replays). Live only.
PROOFHUNTER_API_TOKEN=
PROOFHUNTER_OPERATOR_TOKEN=

# --- Meta Model API (worker only, live only)
MODEL_API_KEY=
META_MODEL=muse-spark-1.3

# --- SubQ Snap (worker only, live only)
SUBQ_API_KEY=
SUBQ_MODEL=subq-snap-1.1

# --- Daytona (sandbox worker only, live only; must match the tested isolation fingerprint)
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_SNAPSHOT=
DAYTONA_IMAGE_DIGEST=
PROOFHUNTER_ENABLE_LIVE_RUNNER=false

# --- GitHub App (worker and webhook handler, live only)
GITHUB_APP_ID=
# Choose exactly one: in-memory PEM (literal \\n accepted) or a PEM file path.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_API_VERSION=2026-03-10
GITHUB_WEBHOOK_SECRET=
PROOFHUNTER_ENABLE_GITHUB_WEBHOOK=false
PROOFHUNTER_ENABLE_GITHUB_CHECKS=false

# --- ACP process only (uAgents mailbox mode: Agent(seed=AGENT_SEED_PHRASE, mailbox=True))
AGENT_SEED_PHRASE=
AGENT_PORT=8001
